# ==============================================================================
# CONFIGURACIÓN GLOBAL DEL SISTEMA INTELIGENTE DE CONTROL DE PEAJE (IAM-811)
# Copiar este archivo a .env (en /web y /inferencia) y completar los valores reales.
# PROHIBIDO subir el archivo .env con credenciales reales al repositorio Git.
# ==============================================================================

# --- 1. BASE DE DATOS (SQLite en nube o PostgreSQL/MySQL gestionado) ---
# Ejemplo SQLite: sqlite:///./peaje.db
# Ejemplo PostgreSQL: postgresql://usuario:password@host:5432/peaje_db
DATABASE_URL=sqlite:///./peaje.db

# --- 2. AUTENTICACIÓN GOOGLE OAUTH 2.0 y JWT DEL SISTEMA ---
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
JWT_SECRET_KEY=cambia-esta-clave-secreta-jwt-de-al-menos-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Lista blanca inicial de administradores (separados por coma)
ADMIN_EMAILS=doc.alvaro.pinto.ma@unifranz.edu.bo,jhairpinto8@gmail.com

# --- 3. ENDPOINT DE INFERENCIA EN LA NUBE (RunPod o Google Colab) ---
# Cambiar entre RunPod y Colab es solo modificar INFERENCE_URL (Sección 3)
# Ejemplo RunPod: https://abc123xyz-8000.proxy.runpod.net
# Ejemplo Colab (Cloudflare Tunnel): https://random-words.trycloudflare.com
INFERENCE_URL=https://tu-pod-id-8000.proxy.runpod.net
INFERENCE_API_TOKEN=token_secreto_inferencia_peaje_2026
INFERENCE_TIMEOUT_SECONDS=45

# --- 4. AGENTE CONVERSACIONAL CON QWEN (VÍA API KEY) ---
# Soporta DashScope (Alibaba Cloud), OpenRouter, TogetherAI o cualquier endpoint OpenAI-compatible
# DashScope Internacional: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OpenRouter: https://openrouter.ai/api/v1
QWEN_API_KEY=sk-tu-api-key-de-qwen
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- 5. CONFIGURACIÓN DEL SERVIDOR DE INFERENCIA (RunPod / Colab) ---
PORT=8000
API_TOKEN=token_secreto_inferencia_peaje_2026
MODEL_M1_PATH=weights/m1_placas.pt
MODEL_M2_PATH=weights/m2_vehiculos_seg.pt
MODEL_M3_PATH=weights/m3_ruedas_pose.pt
OCR_LANGS=es,en
CONF_THRESHOLD_M1=0.35
CONF_THRESHOLD_M2=0.40
CONF_THRESHOLD_M3=0.40
